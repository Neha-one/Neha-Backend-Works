<%- include('../partials/head') %>

  <body>
    <%- include('../partials/navbar') %>

      <main class="min-h-screen bg-gray-100 py-10">
        <div class="max-w-xl mx-auto px-6">
          <div class="bg-white rounded-xl shadow-lg p-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">
              <%= editing ? "Edit Home" : "Add Home" %>
            </h1>
            <p class="text-gray-500 mb-8">
              <%= editing ? "Edit in the details below to update home" : "Fill in the details below to add a new home."
                %>
            </p>
            <form action="/host/<%= editing ? "edit-home" : "add-home" %>" method="POST" class="space-y-6">
              <input type="hidden" name="id" value="<%= editing ? home.id : '' %>" />
              <!-- home Logo -->
              <div>
                <label for="imageURL" class="block text-sm font-medium text-gray-700 mb-1">
                  image (URL)
                </label>
                <input type="text" id="imageURL" name="imageURL" placeholder="Enter image URL"
                  value="<%= editing ? home.imageURL : "" %>"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent" />
              </div>
              <!-- home Name -->
              <div>
                <label for="homeName" class="block text-sm font-medium text-gray-700 mb-1">
                  Name
                </label>
                <input type="text" id="homeName" name="homeName" placeholder="Enter house name" required
                  value="<%= editing ? home.homeName : "" %>" class=" w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2
                  focus:ring-rose-400 focus:border-transparent" />
              </div>
              <div>
                <label for="homePrice" class="block text-sm font-medium text-gray-700 mb-1">
                  Price
                </label>
                <input type="number" id="homePrice" name="homePrice" placeholder="Enter house price" required
                  value="<%= editing ? home.homePrice : "" %>" class=" w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2
                  focus:ring-rose-400 focus:border-transparent" />
              </div>
              <div>
                <label for="location" class="block text-sm font-medium text-gray-700 mb-1">
                  Location
                </label>
                <input type="text" id="location" name="location" placeholder="Enter Location"
                  value="<%= editing ? home.location : "" %>" class=" w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2
                  focus:ring-rose-400 focus:border-transparent" />
              </div>
              <!-- Rating -->
              <div>
                <label for="rating" class="block text-sm font-medium text-gray-700 mb-1">
                  Rating (1–5)
                </label>
                <input type="number" id="rating" name="rating" min="1" max="5" placeholder="Enter rating"
                  value="<%= editing ? home.rating : "" %>" class=" w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2
                  focus:ring-rose-400 focus:border-transparent" />
              </div>
              <div>
                <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
                  Description
                </label>
                <textarea id="description" name="description" placeholder="Describe your home" class=" w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 mb-4
                  focus:ring-rose-400 focus:border-transparent"><%= editing ? home.description : "" %></textarea>
              </div>
              <!-- Submit -->
              <button type="submit"
                class="w-full bg-rose-500 hover:bg-rose-600 text-white font-semibold py-3 rounded-lg transition-colors duration-200">
                <%= editing ? "Update" : "Add home" %>
              </button>
            </form>
          </div>
        </div>
      </main>
  </body>

  </html>