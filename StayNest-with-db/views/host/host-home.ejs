<%- include('../partials/head') %>

  </head>

  <body class="bg-gray-100">

    <%- include('../partials/navbar') %>

      <main class="max-w-7xl mx-auto mt-10 px-6">
        <h1 class="text-4xl font-bold text-gray-800 text-center mb-10">
          Registered Homes
        </h1>

        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

          <% addedHome.forEach(home=> { %>

            <li class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">

              <!-- Image -->
              <div class="h-56 overflow-hidden">
                <img src="<%= home.imageURL %>" alt="<%= home.homeName %>"
                  class="w-full h-full object-cover hover:scale-105 transition duration-500">
              </div>

              <!-- Content -->
              <div class="p-5">

                <div class="flex justify-between items-start mb-2">
                  <h2 class="text-xl font-bold text-gray-800">
                    <%= home.homeName %>
                  </h2>

                  <span class="text-sm bg-yellow-100 text-yellow-700 px-2 py-1 rounded-full">
                    ⭐ <%= home.rating %>
                  </span>
                </div>

                <p class="text-gray-500 mb-4">
                  📍 <%= home.location %>
                </p>

                <div class="flex justify-between items-center">

                  <div>
                    <span class="text-2xl font-bold text-gray-800">
                      ₹<%= home.homePrice %>
                    </span>
                    <span class="text-gray-500">
                      / night
                    </span>
                  </div>
                
                  <div>
                    <a href="/host/edit-home/<%=home.id%>?editing=true"
                      class="inline-block w-fit bg-blue-500 hover:bg-blue-600 text-white px-2 py-2 rounded-lg font-medium transition box-sizing: border-box;">
                      Edit
                    </a>
                    <form action="/host/delete-home/<%=home.id%>" method="POST">
                      <button type="submit"
                        class="inline-block w-fit bg-red-500 hover:bg-red-600 text-white px-2 py-2 rounded-lg font-medium transition box-sizing: border-box;">
                        Delete
                      </button>
                    </form>

                  </div>
                </div>
              </div>

            </li>

            <% }) %>

        </ul>
      </main>

  </body>

  </html>