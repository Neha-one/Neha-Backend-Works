<%- include('../partials/head') %>

  <body>
    <%- include('../partials/navbar') %>

      <main class="min-h-screen bg-gray-100 py-10">
        <div class="max-w-xl mx-auto px-6">
          <div class="bg-white rounded-xl shadow-lg p-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Add Skill</h1>
            <p class="text-gray-500 mb-8">Fill in the details below to add a new skill.</p>
            <form action="/add-skill" method="POST" class="space-y-6">
              <!-- Skill Logo -->
              <div>
                <label for="skillLogo" class="block text-sm font-medium text-gray-700 mb-1">
                  Skill Logo (Image URL)
                </label>
                <input type="text" id="skillLogo" name="skillLogo" placeholder="https://example.com/logo.png"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent" />
              </div>
              <!-- Skill Name -->
              <div>
                <label for="skillName" class="block text-sm font-medium text-gray-700 mb-1">
                  Skill Name
                </label>
                <input type="text" id="skillName" name="skillName" placeholder="e.g. JavaScript, Node.js" required
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent" />
              </div>
              <!-- Time Taken -->
              <div>
                <label for="timeTaken" class="block text-sm font-medium text-gray-700 mb-1">
                  Time Taken
                </label>
                <input type="text" id="timeTaken" name="timeTaken" placeholder="e.g. 3 months, 6 weeks"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent" />
              </div>
              <!-- Rating -->
              <div>
                <label for="rating" class="block text-sm font-medium text-gray-700 mb-1">
                  Rating (1–5)
                </label>
                <input type="number" id="rating" name="rating" min="1" max="5" placeholder="Enter rating"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent" />
              </div>
              <div>
                <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                <textarea  type="text" placeholder="description" name="description" id="description" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent" ></textarea>
              </div>
              <!-- Submit -->
              <button type="submit"
                class="w-full bg-rose-500 hover:bg-rose-600 text-white font-semibold py-3 rounded-lg transition-colors duration-200">
                Add Skill
              </button>
            </form>
          </div>
        </div>
      </main>
  </body>
  </html>